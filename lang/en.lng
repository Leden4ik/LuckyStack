# --- Строки интерфейса: установка, проверка, обновление, команды (ноябрь 2026) ---
# %s в ключе — подставляемое значение (версия, путь, цвет), в переводе на том же месте.
_I18N["%s %s(ошибка)%s"]="%s %s(failed)%s"
_I18N["%s %s, в репозитории %s: luckyctl update pkgs"]="%s %s, repository has %s: luckyctl update pkgs"
_I18N["%s %s: последняя версия в репозитории"]="%s %s: latest version in the repository"
_I18N["%s (%s): %s (не критично)"]="%s (%s): %s (not critical)"
_I18N["%s (%s): activating (ещё запускается)"]="%s (%s): activating (still starting)"
_I18N["%s (%s): статус неизвестен"]="%s (%s): status unknown"
_I18N["%s есть, но это НЕ валидный tar.gz (возможно, сохранилась HTML-страница Cloudflare). Перекачайте архив."]="%s exists, but it is NOT a valid tar.gz (probably a saved Cloudflare HTML page). Download the archive again."
_I18N["%s ещё нет. Залейте файл и нажмите Enter."]="%s is not there yet. Upload the file and press Enter."
_I18N["%s не выпуск, а ветка или коммит: подписи у него нет, ставлю без проверки."]="%s is not a release but a branch or commit: it has no signature, installing without verification."
_I18N["%s не найден — SSH-харденинг пропущен."]="%s not found, SSH hardening skipped."
_I18N["%s не найден — TLS-харденинг Postfix пропущен."]="%s not found, Postfix TLS hardening skipped."
_I18N["%s не найден — порт SSH не изменён."]="%s not found, SSH port not changed."
_I18N["%s слушает на 0.0.0.0 — доступен из интернета! привяжите к 127.0.0.1 (порт %s)"]="%s listens on 0.0.0.0, reachable from the internet! Bind it to 127.0.0.1 (port %s)"
_I18N["%s: завершилось с ошибкой (код %s), остальные шаги продолжаются."]="%s: finished with an error (code %s), the remaining steps continue."
_I18N["%s: ограничения systemd применены."]="%s: systemd restrictions applied."
_I18N["%s: ограничения systemd сняты."]="%s: systemd restrictions removed."
_I18N["%s: ответ не получен (%s)"]="%s: no response (%s)"
_I18N["%s: с ограничениями служба не запустилась, откатил. См. journalctl -u %s"]="%s: the service did not start with restrictions, rolled back. See journalctl -u %s"
_I18N["(TLS-настройки Postfix оставлены; откат — из /etc/postfix/main.cf.luckystack.bak.*)"]="(Postfix TLS settings kept; roll back from /etc/postfix/main.cf.luckystack.bak.*)"
_I18N["(БД dbispconfig сохранена)"]="(dbispconfig database kept)"
_I18N["(данные сохранены: %s — для удаления используйте purge data)"]="(data kept: %s, use purge data to delete it)"
_I18N["(запрет пароля без TLS в Dovecot — блок «luckystack: auth-tls» в %s)"]="(Dovecot plaintext password ban without TLS: block «luckystack: auth-tls» in %s)"
_I18N["(неинтерактивный режим — ожидание пропущено, действует фоновый таймер)"]="(non-interactive mode: wait skipped, the background timer is active)"
_I18N["(пароль root MariaDB оставлен в /root/.my.cnf: он нужен, чтобы новая установка открыла сохранённые базы)"]="(MariaDB root password kept in /root/.my.cnf: a new install needs it to open the saved databases)"
_I18N["(сайты клиентов в /var/www/clients сохранены)"]="(client sites in /var/www/clients kept)"
_I18N["(сертификат в ispserver.* и подписка acme.sh не тронуты)"]="(certificate in ispserver.* and acme.sh subscription left untouched)"
_I18N["(сертификаты Let's Encrypt оставлены в /root/.acme.sh, новая установка возьмёт их)"]="(Let's Encrypt certificates kept in /root/.acme.sh, a new install will pick them up)"
_I18N["+ новый, ~ изменён, - удалён. История одного файла: luckyctl changes /путь/к/файлу. Журнал: %s"]="+ new, ~ changed, - deleted. History of one file: luckyctl changes /path/to/file. Log: %s"
_I18N["--from %s: в диапазон входят уже выполненные core-этапы (database/webserver/ispconfig)."]="--from %s: the range includes core stages that are already done (database/webserver/ispconfig)."
_I18N["--only '%s' требует готовый setup.conf, но его нет (%s)."]="--only '%s' needs a ready setup.conf, but it is missing (%s)."
_I18N["--resume: нет незавершённой установки (setup.state пуст)."]="--resume: no unfinished installation (setup.state is empty)."
_I18N["--unattended требует готовый setup.conf, но его нет."]="--unattended needs a ready setup.conf, but it is missing."
_I18N["/etc — системные конфиги (ОПАСНО, может изменить сеть/доступ)"]="/etc: system configs (DANGEROUS, may change network/access)"
_I18N["/etc/hosts уже содержит %s %s"]="/etc/hosts already contains %s %s"
_I18N["/etc/hosts: строка «%s» даёт серверу другое имя, закомментирована."]="/etc/hosts: line «%s» gives the server a different name, commented out."
_I18N["/etc/timezone приведён к поясу системы: %s"]="/etc/timezone set to the system time zone: %s"
_I18N["/tmp/ispconfig.tar.gz — не валидный tar.gz. Повторите с корректным архивом."]="/tmp/ispconfig.tar.gz is not a valid tar.gz. Retry with a correct archive."
